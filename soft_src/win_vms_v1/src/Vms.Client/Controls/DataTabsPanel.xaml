<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vms.Client.Controls.DataTabsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Vms.Client.Models">

    <!--
      右侧下半部分的「数据页签」面板（WinUI Gallery 卡片风格）。

      两个页签共用同一块区域，选中即切：
        · 定位数据 —— 当前范围（全部 / 某组织 / 某台车）内车辆的定位记录；
        · 报警数据 —— 同范围内的报警记录，滚动追加、上限 2000 条。

      两张表都用 ListView 的 UI 虚拟化 + 固定行高，列宽在表头与行模板里**各写一遍**
      （必须严格一致，否则列会错位）；最后一列用 * 吸收剩余宽度。

      ─ 加字段的正确姿势 ──────────────────────────────────────────
      ① Models/PositionRecord.cs（或 AlarmRecord.cs）加属性 + CopyFrom；
      ② 在本文件对应表头 Grid 里加一个 ColumnDefinition + TextBlock；
      ③ 在对应行 DataTemplate 的 Grid 里加同样的 ColumnDefinition + 控件。
      ────────────────────────────────────────────────────────────
    -->
    <Border Style="{StaticResource CardBorder}" Margin="4,4,8,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ======================= 页签条 ======================= -->
            <Border Grid.Row="0" Padding="12,8,12,4"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                        <SelectorBarItem Text="定位数据" Tag="0" />
                        <SelectorBarItem x:Name="AlarmTab" Text="报警数据" Tag="1" />
                    </SelectorBar>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button x:Name="LoadMoreButton" Content="加载更多" FontSize="11" Height="28"
                                Padding="12,0" CornerRadius="{StaticResource ControlCornerRadius}"
                                Click="LoadMore_Click" />
                        <Button Content="导出 CSV" FontSize="11" Height="28" Padding="12,0"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Click="Export_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= 范围提示 ======================= -->
            <Border Grid.Row="1" Padding="12,5" Background="{StaticResource PanelAltBackgroundBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{x:Bind ViewModel.Monitor.ScopeText, Mode=OneWay}"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="HintText" HorizontalAlignment="Right" FontSize="11"
                               Foreground="{StaticResource TextHintBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ======================= 定位数据表 ======================= -->
            <Grid x:Name="PositionPanel" Grid.Row="2" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- 表头行高 = 主题里的 GridHeaderHeight(34)。
                         注意：RowDefinition.Height 的类型是 GridLength，而主题里那个令牌是
                         x:Double，直接 {StaticResource} 会抛 XamlParseException
                         （Double 不能赋给 GridLength）。这类错误编译期不报，只能用字面量。 -->
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource GridHeaderBackgroundBrush}"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <!-- ⚠ 列宽在表头与行模板里必须**各写一遍且完全一致**，否则列会错位。
                             第 0 列是新增的行选择框列（宽度 34），与行模板里的 CheckBox 同宽。 -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="选择" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="1" Text="车牌号" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="2" Text="终端号" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="3" Text="定位时间" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="4" Text="经度" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="5" Text="纬度" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="6" Text="速度" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="7" Text="方向" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="8" Text="海拔" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="9" Text="里程" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="10" Text="定位状态" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="11" Text="在线" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="12" Text="位置" Style="{StaticResource GridHeaderTextCenter}"  />
                    </Grid>
                </Border>

                <ListView x:Name="PositionRows" Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Monitor.Positions, Mode=OneWay}"
                          SelectionMode="None"
                          ItemContainerStyle="{StaticResource GridRowContainerNoSelect}"
                          AllowDrop="True"
                          ContainerContentChanging="PositionRows_ContainerContentChanging">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PositionRecord">
                            <!--
                              行交互分三条，互不干扰：
                              ① 右键 → FloatingMenu（复制/轨迹回访/…6 项）
                              ② 点选择框列（第 0 列）→ 只切该行勾选，不触发列高亮
                              ③ 点其它列 → 高亮"当前列"（跨所有行同列高亮）
                              ③靠 PositionRow_Tapped 判断原始来源落在第几列来实现。
                            -->
                            <Grid Background="Transparent"
                                  Tapped="PositionRow_Tapped"
                                  RightTapped="PositionRow_RightTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 第 0 列：行选择框。勾它只管勾选，LabeledBy 无关，
                                     实际勾选态回写由 Checked/Unchecked 事件驱动（见代码后置）。 -->
                                <!-- ⚠ 不设 Width：WinUI 3 的 CheckBox 用 AnimatedIcon 画框，
                                     Width 小于框体宽度会把框右侧切掉、勾画不全（实机反馈）。
                                     只压 MinWidth（去默认 120），框体大小随 FontSize 自适应。 -->
                                <CheckBox Grid.Column="0" MinWidth="0" Padding="0"
                                          FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                          Checked="PositionRowCheck_Changed"
                                          Unchecked="PositionRowCheck_Changed" />

                                <Border Grid.Column="1" Tag="1" Background="Transparent">
                                    <TextBlock Text="{x:Bind Plate}" FontSize="12" FontWeight="SemiBold"
                                           Style="{StaticResource TableCellTextCenter}"
                                           Foreground="{x:Bind State, Mode=OneWay, Converter={StaticResource VehicleStateBrush}}"  />
                                </Border>
                                <Border Grid.Column="2" Tag="2" Background="Transparent">
                                    <TextBlock Text="{x:Bind DeviceCode}" Style="{StaticResource TableCellTextCenter}" FontFamily="{StaticResource NumberFontFamily}" />
                                </Border>
                                <Border Grid.Column="3" Tag="3" Background="Transparent">
                                    <TextBlock Text="{x:Bind GpsTime}" Style="{StaticResource TableCellTextCenter}" FontFamily="{StaticResource NumberFontFamily}"  />
                                </Border>
                                <Border Grid.Column="4" Tag="4" Background="Transparent">
                                    <TextBlock Text="{x:Bind LonText}" Style="{StaticResource TableNumericTextCenter}" />
                                </Border>
                                <Border Grid.Column="5" Tag="5" Background="Transparent">
                                    <TextBlock Text="{x:Bind LatText}" Style="{StaticResource TableNumericTextCenter}" />
                                </Border>
                                <Border Grid.Column="6" Tag="6" Background="Transparent">
                                    <TextBlock Text="{x:Bind SpeedText}" Style="{StaticResource TableNumericTextCenter}"  />
                                </Border>
                                <Border Grid.Column="7" Tag="7" Background="Transparent">
                                    <TextBlock Text="{x:Bind DirectionText}" Style="{StaticResource TableNumericTextCenter}" />
                                </Border>
                                <Border Grid.Column="8" Tag="8" Background="Transparent">
                                    <TextBlock Text="{x:Bind AltitudeText}" Style="{StaticResource TableNumericTextCenter}" />
                                </Border>
                                <Border Grid.Column="9" Tag="9" Background="Transparent">
                                    <TextBlock Text="{x:Bind MileageText}" Style="{StaticResource TableNumericTextCenter}" />
                                </Border>
                                <Border Grid.Column="10" Tag="10" Background="Transparent">
                                    <TextBlock Text="{x:Bind LocateState}" Style="{StaticResource TableCellTextCenter}" />
                                </Border>
                                <Border Grid.Column="11" Tag="11" Background="Transparent">
                                    <TextBlock Text="{x:Bind OnlineText}" Style="{StaticResource TableCellTextCenter}" Foreground="{x:Bind State, Mode=OneWay, Converter={StaticResource VehicleStateBrush}}"  />
                                </Border>
                                <Border Grid.Column="12" Tag="12" Background="Transparent">
                                    <TextBlock Text="{x:Bind Address}" Style="{StaticResource TableCellTextCenter}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ======================= 报警数据表 ======================= -->
            <Grid x:Name="AlarmPanel" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- 表头行高 = 主题里的 GridHeaderHeight(34)。
                         注意：RowDefinition.Height 的类型是 GridLength，而主题里那个令牌是
                         x:Double，直接 {StaticResource} 会抛 XamlParseException
                         （Double 不能赋给 GridLength）。这类错误编译期不报，只能用字面量。 -->
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource GridHeaderBackgroundBrush}"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="选择" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="1" Text="车牌号" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="2" Text="终端号" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="3" Text="报警时间" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="4" Text="报警类型" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="5" Text="等级" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="6" Text="报警速度" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="7" Text="报警位置" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="8" Text="处理状态" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="9" Text="处理人" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="10" Text="处理时间" Style="{StaticResource GridHeaderTextCenter}" />
                        <TextBlock Grid.Column="11" Text="处理说明" Style="{StaticResource GridHeaderTextCenter}" />
                    </Grid>
                </Border>

                <ListView x:Name="AlarmRows" Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Monitor.Alarms, Mode=OneWay}"
                          SelectionMode="None"
                          ItemContainerStyle="{StaticResource GridRowContainerNoSelect}"
                          ContainerContentChanging="AlarmRows_ContainerContentChanging">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AlarmRecord">
                            <Grid Background="Transparent"
                                  Tapped="AlarmRow_Tapped"
                                  RightTapped="AlarmRow_RightTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <!-- ⚠ 不设 Width：WinUI 3 的 CheckBox 用 AnimatedIcon 画框，
                                     Width 小于框体宽度会把框右侧切掉、勾画不全（实机反馈）。
                                     只压 MinWidth（去默认 120），框体大小随 FontSize 自适应。 -->
                                <CheckBox Grid.Column="0" MinWidth="0" Padding="0"
                                          FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                          Checked="AlarmRowCheck_Changed"
                                          Unchecked="AlarmRowCheck_Changed" />

                                <Border Grid.Column="1" Tag="1" Background="Transparent">
                                    <TextBlock Text="{x:Bind Plate}" Style="{StaticResource TableCellTextCenter}"
                                           FontWeight="SemiBold" Foreground="{StaticResource AlarmBrush}"  />
                                </Border>
                                <Border Grid.Column="2" Tag="2" Background="Transparent">
                                    <TextBlock Text="{x:Bind DeviceCode}" Style="{StaticResource TableCellTextCenter}" FontFamily="{StaticResource NumberFontFamily}"  />
                                </Border>
                                <Border Grid.Column="3" Tag="3" Background="Transparent">
                                    <TextBlock Text="{x:Bind AlarmTime}" Style="{StaticResource TableCellTextCenter}" FontFamily="{StaticResource NumberFontFamily}"  />
                                </Border>
                                <Border Grid.Column="4" Tag="4" Background="Transparent">
                                    <TextBlock Text="{x:Bind AlarmType}" Style="{StaticResource TableCellTextCenter}"  />
                                </Border>
                                <Border Grid.Column="5" Tag="5" Background="Transparent">
                                    <TextBlock Text="{x:Bind Level}" Style="{StaticResource TableCellTextCenter}"  />
                                </Border>
                                <Border Grid.Column="6" Tag="6" Background="Transparent">
                                    <TextBlock Text="{x:Bind SpeedText}" Style="{StaticResource TableNumericTextCenter}"  />
                                </Border>
                                <Border Grid.Column="7" Tag="7" Background="Transparent">
                                    <TextBlock Text="{x:Bind Address}" Style="{StaticResource TableCellTextCenter}"  />
                                </Border>
                                <Border Grid.Column="8" Tag="8" Background="Transparent">
                                    <TextBlock Text="{x:Bind HandleState}" Style="{StaticResource TableCellTextCenter}" Foreground="{StaticResource AccentBrush}"  />
                                </Border>
                                <Border Grid.Column="9" Tag="9" Background="Transparent">
                                    <TextBlock Text="{x:Bind Handler}" Style="{StaticResource TableCellTextCenter}"  />
                                </Border>
                                <Border Grid.Column="10" Tag="10" Background="Transparent">
                                    <TextBlock Text="{x:Bind HandleTime}" Style="{StaticResource TableCellTextCenter}" FontFamily="{StaticResource NumberFontFamily}"  />
                                </Border>
                                <Border Grid.Column="11" Tag="11" Background="Transparent">
                                    <TextBlock Text="{x:Bind HandleNote}" Style="{StaticResource TableCellTextCenter}"  />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ======================= 状态条 ======================= -->
            <Border Grid.Row="3" Height="28" Padding="12,0"
                    Background="{StaticResource PanelAltBackgroundBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{x:Bind ViewModel.Monitor.LoadStateText, Mode=OneWay}"
                           Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>
