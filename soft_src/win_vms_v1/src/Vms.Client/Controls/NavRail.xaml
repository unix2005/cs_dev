<UserControl
    x:Class="Vms.Client.Controls.NavRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vms.Client.ViewModels"
    xmlns:controls="using:Vms.Client.Controls">

    <!--
      左侧导航栏（WinUI Gallery 侧栏风格）。

      版面（自上而下）：
        ① 功能导航 —— 六个一级模块；「实时监控」展开后内嵌组织/车辆树
        ② 后端来源 —— 一眼看出看的是真数据还是模拟数据

      视觉要点：
        · 底色与外壳一致（#F3F3F3），不画边框 —— 层级由右侧的白色卡片承担；
        · 选中态 = 浅强调底 + 圆角 + 强调色文字 + 行首 3px 指示条；
        · 宽度由 MainWindow 的列定义控制，用户可拖拽分隔条改变，这里只能 Stretch。

      「实时监控」项的内嵌树：
        · 点击该项的向下箭头 → IsExpanded 变 true → 一级按钮下方显示组织/车辆树；
        · 切到别的模块时，监控项的 IsExpanded 被置 false，树随展开区一起收起
          （树的状态——展开的分公司、勾选范围——都存在 ViewModel 里，不会丢）；
        · 树现在和导航项、后端来源一起放在同一个 ScrollViewer 里滚动，
          不再有"树上滚到底顺手把导航也滚了"的嵌套滚动怪手感。

      ⚠ 资源字典必须写在 NavRail 这一层（UserControl.Resources），不能塞进
        ItemsControl.Resources 再用 StaticResource 反引回 ItemsControl 的属性 ——
        那样会触发"Cannot find a Resource with the Key …"的 XamlParseException
        （同元素 Resources 里的资源，不能在该元素自身属性上用 StaticResource 解析，
         解析时机早于 Resources 填充）。模板排在选择器之前（选择器用 StaticResource 引用它们）。
    -->
    <UserControl.Resources>
        <!-- ============ 普通模块模板（无内嵌树） ============ -->
        <DataTemplate x:Key="SimpleNavItemTemplate" x:DataType="vm:NavItem">
            <StackPanel>
                <!-- 一级项 -->
                <Button Style="{StaticResource NavItemButton}"
                        Tag="{x:Bind}"
                        Click="NavItem_Click"
                        Background="{x:Bind IsSelected, Converter={StaticResource NavItemBackground}, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5"
                                Background="{x:Bind IsSelected, Converter={StaticResource NavIndicator}, Mode=OneWay}" />

                        <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="16"
                                  Margin="9,0,0,0" VerticalAlignment="Center"
                                  Foreground="{x:Bind IsSelected, Converter={StaticResource NavItemForeground}, Mode=OneWay}" />

                        <TextBlock Grid.Column="2" Text="{x:Bind Title}" FontSize="14"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{x:Bind IsSelected, Converter={StaticResource NavItemForeground}, Mode=OneWay}" />

                        <!-- 展开箭头：只有有二级项的模块才显示 -->
                        <FontIcon Grid.Column="3" Glyph="&#xE70D;" FontSize="11" Margin="6,0,4,0"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextHintBrush}"
                                  Visibility="{x:Bind IsExpanded, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="11" Margin="6,0,4,0"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextHintBrush}"
                                  Visibility="{x:Bind HasChildrenAndCollapsed, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                    </Grid>
                </Button>

                <!-- 二级项 -->
                <ItemsControl ItemsSource="{x:Bind Children}"
                              Visibility="{x:Bind IsExpanded, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <Button Style="{StaticResource NavSubItemButton}"
                                    Content="{x:Bind Title}"
                                    Tag="{x:Bind}"
                                    Click="NavItem_Click"
                                    Background="{x:Bind IsCurrent, Converter={StaticResource NavItemBackground}, Mode=OneWay}"
                                    Foreground="{x:Bind IsCurrent, Converter={StaticResource NavItemForeground}, Mode=OneWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- ============ 实时监控模板（内嵌组织/车辆树） ============ -->
        <DataTemplate x:Key="MonitorNavItemTemplate" x:DataType="vm:NavItem">
            <StackPanel>
                <!-- 一级项：实时监控 -->
                <Button Style="{StaticResource NavItemButton}"
                        Tag="{x:Bind}"
                        Click="NavItem_Click"
                        Background="{x:Bind IsSelected, Converter={StaticResource NavItemBackground}, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5"
                                Background="{x:Bind IsSelected, Converter={StaticResource NavIndicator}, Mode=OneWay}" />

                        <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="16"
                                  Margin="9,0,0,0" VerticalAlignment="Center"
                                  Foreground="{x:Bind IsSelected, Converter={StaticResource NavItemForeground}, Mode=OneWay}" />

                        <TextBlock Grid.Column="2" Text="{x:Bind Title}" FontSize="14"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{x:Bind IsSelected, Converter={StaticResource NavItemForeground}, Mode=OneWay}" />

                        <FontIcon Grid.Column="3" Glyph="&#xE70D;" FontSize="11" Margin="6,0,4,0"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextHintBrush}"
                                  Visibility="{x:Bind IsExpanded, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="11" Margin="6,0,4,0"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextHintBrush}"
                                  Visibility="{x:Bind HasChildrenAndCollapsed, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                    </Grid>
                </Button>

                <!-- 展开区：组织/车辆树。只有展开（IsExpanded）时才显示。
                     不设左右外边距 —— 树要贴侧栏左缘（用户提过两次"没靠左"）。 -->
                <controls:CompanyTreePanel
                    Visibility="{x:Bind IsExpanded, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                    Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <controls:NavItemTemplateSelector x:Key="NavItemSelector"
                                         SimpleTemplate="{StaticResource SimpleNavItemTemplate}"
                                         MonitorTemplate="{StaticResource MonitorNavItemTemplate}" />
    </UserControl.Resources>

    <Border Background="{StaticResource NavRailBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="功能导航" Style="{StaticResource SectionHeaderText}"
                       Margin="18,16,0,8" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{x:Bind ViewModel.NavItems}" Margin="0,0,0,8"
                              ItemTemplateSelector="{StaticResource NavItemSelector}" />
            </ScrollViewer>

            <!-- 底部：后端来源指示。值班时"我现在看的是真数据还是模拟数据"必须一眼可见 -->
            <Border Grid.Row="2" Padding="18,10,12,14"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{x:Bind ViewModel.UsingNativeBackend, Mode=OneWay, Converter={StaticResource NativeDotBrush}}" />
                        <TextBlock Text="{x:Bind ViewModel.BackendBadge, Mode=OneWay}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="10"
                               Foreground="{StaticResource TextHintBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind ViewModel.NativeDiagnostics, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
