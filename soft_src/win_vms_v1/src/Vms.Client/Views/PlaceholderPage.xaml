<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vms.Client.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource ShellBackgroundBrush}">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="560">
            <FontIcon Glyph="&#xE7C3;" FontSize="38" Foreground="{StaticResource BorderStrongBrush}" />
            <TextBlock x:Name="TitleText" Text="模块" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock x:Name="BodyText" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="该模块尚未实现。导航、内容区、状态栏已经打通，新增页面只需在 Views 下加一个 Page 并挂到 MainWindow 的导航分支上。" />
            <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="建议实现顺序（按业务价值）" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="① 行驶记录·轨迹回放：复用同一个 native 查询 + 地图 polyline 回放" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="② 违规报警·报警处理：报警表 + 处理动作（下发指令走 native 写接口）" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="③ 监控管理·车辆/分组：CRUD，注意所有写操作都要有二次确认与审计日志" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="④ 指令交互：下发/回执状态机，超时重试与去重是重点" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
