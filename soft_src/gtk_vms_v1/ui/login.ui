<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkWindow" id="login_window">
    <property name="title">车辆管理系统 - 登录</property>
    <property name="default-width">360</property>
    <property name="default-height">280</property>
    <property name="resizable">False</property>
    <child>
      <object class="GtkBox" id="login_box">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin-top">20</property>
        <property name="margin-bottom">20</property>
        <property name="margin-start">24</property>
        <property name="margin-end">24</property>
        <child>
          <object class="GtkLabel" id="login_title">
            <property name="label">车辆管理系统</property>
            <property name="name">login-title</property>
            <attributes>
              <attribute name="weight" value="bold"/>
              <attribute name="scale" value="1.4"/>
            </attributes>
          </object>
        </child>
        <child>
          <object class="GtkEntry" id="entry_user">
            <property name="placeholder-text">用户名</property>
            <property name="input-purpose">name</property>
          </object>
        </child>
        <child>
          <object class="GtkPasswordEntry" id="entry_pass">
            <property name="placeholder-text">密码</property>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="remember_chk">
            <property name="label">记住密码</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="btn_login">
            <property name="label">登录</property>
            <property name="receives-default">True</property>
            <style>
              <class name="suggested-action"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="login_msg">
            <property name="label"></property>
            <property name="name">login-msg</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
