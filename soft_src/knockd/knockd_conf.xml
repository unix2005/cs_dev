<?xml version="1.0" encoding="UTF-8"?>
<!--
  knockd 配置文件（SPA 单包授权进程）
  部署路径：/etc/gtkvms/knockd_conf.xml
  启动方式：knockd -c /abs/path/knockd_conf.xml
  路径优先级：启动参数 -c  >  环境变量 GTKVMS_KNOCKD_CONF  >  默认值
  参数优先级（参数值）：环境变量(GTKVMS_*) > 本文件 > main.c 内 #define 默认值
  注：SPA_KEY_LEN(16, SM4 密钥长度) 为固定安全常数，不接受配置。
-->
<config>
    <knockd>
        <!-- UDP 监听端口（SPA 包接收） -->
        <listen_port>5001</listen_port>

        <!-- SPA 共享密钥文件路径（内容须为 16 字节 = SM4 密钥长度） -->
        <spa_key_file>/etc/gtkvms/spa.key</spa_key_file>

        <!-- nftables 表名（部署前置：nft add table inet spa） -->
        <nft_table>inet spa</nft_table>

        <!-- nftables IPv4 集合名（类型为 ipv4_addr、带 timeout，存放放行的源 IPv4）
             部署前置：nft add set inet spa allow4 { type ipv4_addr; timeout; } -->
        <nft_set>allow4</nft_set>

        <!-- nftables IPv6 集合名（类型为 ipv6_addr、带 timeout，存放放行的源 IPv6）
             部署前置：nft add set inet spa allow6 { type ipv6_addr; timeout; } -->
        <nft_set6>allow6</nft_set6>

        <!-- 开门默认时长（秒）：SPA 报文 req_ttl=0 时取此值 -->
        <default_ttl>300</default_ttl>

        <!-- reactor 轮询超时（毫秒） -->
        <poll_timeout_ms>200</poll_timeout_ms>

        <!-- 日志：log_file 为空则仅输出到控制台(stderr)；文件打开失败自动回退控制台 -->
        <log_file>/var/log/gtkvms/knockd.log</log_file>
        <log_level>info</log_level>
        <log_console>1</log_console>
        <log_max_size>10485760</log_max_size>
    </knockd>
</config>
