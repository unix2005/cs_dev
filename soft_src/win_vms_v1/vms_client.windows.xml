<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows 手动联调专用配置（M5 实时推送验证）
  --------------------------------------------------------------------------
  用法（任选其一）：
    1) 设环境变量后启动 App：
         set VMS_CLIENT_CONF=E:\win_e\cs_dev\soft_src\win_vms_v1\vms_client.windows.xml
    2) 或拷到默认位置：
         %LOCALAPPDATA%\vms\vms_client.xml

  前置：把 Linux 虚拟机上的两个文件拷到本机 E:\win_e\cs_dev\tmp\vmsconf\ ：
         netd_sm2.pub   （服务端静态 SM2 公钥，命令/推送两栈共用）
         spa.key        （SPA 单包敲门密钥；KNOCK=0 直连模式用不到，但填了无害）
    scp 示例（在 Windows Git Bash / PowerShell 里）：
         scp qiao@192.168.19.22:/tmp/vmsconf/netd_sm2.pub  E:/win_e/cs_dev/tmp/vmsconf/
         scp qiao@192.168.19.22:/tmp/vmsconf/spa.key        E:/win_e/cs_dev/tmp/vmsconf/

  关键差异（相对原 vms_client.xml）：
    - pubkey_path / spa_key_path 改为本机 Windows 路径（原文件写的是 /home/qiao/...）
    - 新增 <push> 段：指向 M5 推送栈（netd_B 18098 + knockd_B 5002）。
      不写这个段，推送会回退到命令端口 18099，连不到推送栈，GUI 里看不到实时流。
    - host 指向虚拟机 192.168.19.22（同一网段可达；若改了 IP 这里同步改）
-->
<vms_client>

  <!-- ================= 服务端（netd 命令连接 A 栈）================= -->
  <server>
    <host>192.168.19.22</host>
    <port>18099</port>
    <pubkey_path>E:\win_e\cs_dev\tmp\vmsconf\netd_sm2.pub</pubkey_path>
    <seq0>1</seq0>
    <key_id>1</key_id>
  </server>

  <!-- ================= 身份与口令派生 ================= -->
  <auth>
    <user>qiaoshui</user>
    <password>123456</password>
    <otp></otp>
    <devid_hex></devid_hex>
    <pbkdf2_iter>0</pbkdf_iter>
  </auth>

  <!-- ================= SPA 单包敲门（可选）=================
       仅当虚拟机侧用 KNOCK=1 起了 knockd 时才需要。
       直连模式（虚拟机 run_m5_services.sh 默认 KNOCK=0）可整套删掉，
       或保留也无妨——客户端敲门失败会自动回退直连尝试。 -->
  <knock>
    <endpoint>192.168.19.22:5001</endpoint>
    <spa_key_path>E:\win_e\cs_dev\tmp\vmsconf\spa.key</spa_key_path>
    <req_port>18099</req_port>
    <req_ttl>300</req_ttl>
    <key_id>1</key_id>
  </knock>

  <!-- ================= M5 推送栈（B 栈，必须显式写）=================
       推送走第二条独立 TCP 长连接：netd_B(18098) 藏在 knockd_B(5002) 后。
       省略此段 → 推送回退 server.* → 连到命令端口 18099 → 收不到推送帧。 -->
  <push>
    <host>192.168.19.22</host>
    <port>18098</port>
    <knock>192.168.19.22:5002</knock>
  </push>

  <!-- ================= 会话治理（M4）================= -->
  <keeper>
    <heartbeat_ms>60000</heartbeat_ms>
    <backoff_base_ms>1000</backoff_base_ms>
    <backoff_max_ms>30000</backoff_max_ms>
    <max_retry>0</max_retry>
    <auto_start>1</auto_start>
  </keeper>

  <!-- ================= 客户端自身 ================= -->
  <app>
    <client_version>1.2.0</client_version>
    <log_level>info</log_level>
    <connect_timeout_ms>5000</connect_timeout_ms>
  </app>

</vms_client>
