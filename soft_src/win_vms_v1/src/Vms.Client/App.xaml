<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Vms.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Vms.Client.Converters"
    RequestedTheme="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Theme/VmsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== 转换器（约 60 行代码替代整个 CommunityToolkit 依赖） ===== -->

            <!-- 侧栏导航：选中=浅强调底 + 强调色文字 + 左侧指示条 -->
            <conv:BoolToBrushConverter x:Key="NavItemBackground"
                                       TrueBrush="{StaticResource AccentSoftBrush}"
                                       FalseBrush="{StaticResource TransparentBrush}" />
            <conv:BoolToBrushConverter x:Key="NavItemForeground"
                                       TrueBrush="{StaticResource AccentStrongBrush}"
                                       FalseBrush="{StaticResource TextPrimaryBrush}" />
            <conv:BoolToBrushConverter x:Key="NavIndicator"
                                       TrueBrush="{StaticResource AccentBrush}"
                                       FalseBrush="{StaticResource TransparentBrush}" />

            <!-- 车辆三态：报警红 > 在线蓝 > 离线灰 -->
            <conv:VehicleStateToBrushConverter x:Key="VehicleStateBrush"
                                               OnlineBrush="{StaticResource StatusOnlineBrush}"
                                               OfflineBrush="{StaticResource StatusOfflineBrush}"
                                               AlarmBrush="{StaticResource AlarmBrush}" />
            <conv:StateToAlarmVisibilityConverter x:Key="AlarmStateVisibility" />

            <!-- 后端来源指示点：绿=真接到 native 库，橙=降级到内置模拟 -->
            <conv:BoolToBrushConverter x:Key="NativeDotBrush"
                                       TrueBrush="{StaticResource SuccessBrush}"
                                       FalseBrush="{StaticResource WarningBrush}" />

            <!-- 通用 -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityInverted" Invert="True" />
            <conv:AlarmToVisibilityConverter x:Key="AlarmToVisibility" />

            <!-- 全局字体：Noto Sans SC（思源黑体），未安装则回退微软雅黑（见 AppFontFamily 字体栈）。
                 这些隐式样式**只设 FontFamily 一个 Setter、不改 BasedOn/Template**，
                 因此不会覆盖控件默认模板，只是把字体换掉。
                 TextBlock 无模板，最安全；其余控件带模板，但仅设字体不会动模板，
                 实测不会破坏 Button/CheckBox/AutoSuggestBox 的默认外观。
                 图标类字体（Segoe Fluent Icons）由各图标按钮的 Style 单独指定，不受此影响。 -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <Style TargetType="AutoSuggestBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <Style TargetType="ToolTip">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
